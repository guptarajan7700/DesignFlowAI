<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>DesignFlow.Revit</RootNamespace>
    <AssemblyName>DesignFlow.Revit</AssemblyName>
    <LangVersion>latest</LangVersion>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2025.3.0" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2025.3.0" />
  </ItemGroup>

</Project>
